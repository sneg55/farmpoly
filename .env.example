# Polygon wallet private key (64 hex chars, no 0x prefix)
POLYGON_PRIVATE_KEY=

# Optional: RPC URL (defaults to public Polygon RPC)
POLYGON_RPC_URL=https://polygon-rpc.com

# Optional: Polymarket CLOB API base URL
CLOB_API_URL=https://clob.polymarket.com

# Optional: Gamma API base URL
GAMMA_API_URL=https://gamma-api.polymarket.com
